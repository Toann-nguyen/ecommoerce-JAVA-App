<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/categoriesChipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAllCategories"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Tất cả"
            app:chipBackgroundColor="@color/chip_background_color"
            app:chipIconVisible="false"
            app:chipStrokeColor="@color/md_theme_light_outline"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPhones"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điện thoại"
            app:chipBackgroundColor="@color/chip_background_color"
            app:chipIconVisible="false"
            app:chipStrokeColor="@color/md_theme_light_outline"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLaptops"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laptop"
            app:chipBackgroundColor="@color/chip_background_color"
            app:chipIconVisible="false"
            app:chipStrokeColor="@color/md_theme_light_outline"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTablets"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máy tính bảng"
            app:chipBackgroundColor="@color/chip_background_color"
            app:chipIconVisible="false"
            app:chipStrokeColor="@color/md_theme_light_outline"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAccessories"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phụ kiện"
            app:chipBackgroundColor="@color/chip_background_color"
            app:chipIconVisible="false"
            app:chipStrokeColor="@color/md_theme_light_outline"
            app:chipStrokeWidth="1dp" />

    </com.google.android.material.chip.ChipGroup>
</HorizontalScrollView>